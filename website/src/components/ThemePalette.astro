---
import { themes } from '../lib/theme-catalog';

export interface Props { lang?: 'en' | 'zh-CN' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh-CN';
const choices = [
  { id: 'light', name: isZh ? '默认浅色' : 'Default Light', family: 'GPUI Kit', mode: 'light', colors: { background: '#ffffff', 'primary.background': '#171717' } },
  { id: 'dark', name: isZh ? '默认深色' : 'Default Dark', family: 'GPUI Kit', mode: 'dark', colors: { background: '#0a0a0a', 'primary.background': '#fafafa' } },
  ...themes,
];
---

<button id="theme-palette-open" class="theme-toggle" type="button"
  aria-label={isZh ? '选择主题' : 'Choose theme'} title={isZh ? '选择主题 (⌘⇧T)' : 'Choose theme (⌘⇧T)'}>
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="9"/><circle cx="8" cy="8" r="1"/><circle cx="15" cy="7" r="1"/><circle cx="17" cy="13" r="1"/><path d="M12 21c-1.8-1.8-1.3-4 .8-4.7 1.3-.5 2.8.2 4-.6"/>
  </svg>
</button>

<dialog id="theme-palette" aria-labelledby="theme-palette-title">
  <h2 id="theme-palette-title" class="sr-only">{isZh ? '选择主题' : 'Choose theme'}</h2>
  <label class="theme-palette__search">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input id="theme-palette-query" type="search" autocomplete="off"
      placeholder={isZh ? '搜索主题…' : 'Search themes…'} aria-label={isZh ? '搜索主题' : 'Search themes'} />
  </label>
  <div class="theme-palette__list" role="group" aria-label={isZh ? '可用主题' : 'Available themes'}>
    {choices.map((theme) => (
      <button class="theme-palette__option" type="button" data-theme-id={theme.id} data-mode={theme.mode}
        data-search={`${theme.name} ${theme.family} ${theme.mode}`.toLowerCase()} aria-pressed="false">
        <span class="theme-palette__swatch" style={`--swatch-bg:${theme.colors.background};--swatch-accent:${theme.colors['primary.background'] ?? theme.colors.foreground}`} aria-hidden="true"></span>
        <span class="theme-palette__name">{theme.name}<small>{theme.family}</small></span>
        <span class="theme-palette__mode">{theme.mode}</span>
        <span class="theme-palette__check" aria-hidden="true">✓</span>
      </button>
    ))}
    <p class="theme-palette__empty" hidden>{isZh ? '没有匹配的主题' : 'No matching themes'}</p>
  </div>
  <p class="search-footer" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> {isZh ? '选择' : 'Navigate'}</span>
    <span><kbd>↵</kbd> {isZh ? '应用' : 'Apply'}</span>
    <span><kbd>Esc</kbd> {isZh ? '关闭' : 'Close'}</span>
  </p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#theme-palette');
  const trigger = document.querySelector<HTMLButtonElement>('#theme-palette-open');
  const query = document.querySelector<HTMLInputElement>('#theme-palette-query');
  const options = [...(dialog?.querySelectorAll<HTMLButtonElement>('.theme-palette__option') ?? [])];
  const empty = dialog?.querySelector<HTMLElement>('.theme-palette__empty');

  function syncSelected() {
    const current = localStorage.getItem('theme') ?? (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    options.forEach((option) => option.setAttribute('aria-pressed', String(option.dataset.themeId === current)));
  }

  function filter() {
    const term = query?.value.trim().toLowerCase() ?? '';
    let count = 0;
    options.forEach((option) => {
      option.hidden = !option.dataset.search?.includes(term);
      if (!option.hidden) count++;
    });
    if (empty) empty.hidden = count !== 0;
  }

  function open() {
    if (!dialog || !query) return;
    query.value = '';
    filter();
    syncSelected();
    if (!dialog.open) dialog.showModal();
    query.focus();
  }

  trigger?.addEventListener('click', open);
  query?.addEventListener('input', filter);
  options.forEach((option) => option.addEventListener('click', () => {
    const id = option.dataset.themeId!;
    const dark = option.dataset.mode === 'dark';
    document.documentElement.classList.toggle('dark', dark);
    if (id === 'light' || id === 'dark') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = id;
    localStorage.setItem('theme', id);
    document.dispatchEvent(new Event('themechange'));
    dialog?.close();
    trigger?.focus();
  }));

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.shiftKey && event.key.toLowerCase() === 't') {
      event.preventDefault();
      dialog?.open ? dialog.close() : open();
    }
  });

  dialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Enter') return;
    const visible = options.filter((option) => !option.hidden);
    if (!visible.length) return;
    if (event.key === 'Enter') {
      event.preventDefault();
      (visible.includes(document.activeElement as HTMLButtonElement)
        ? document.activeElement as HTMLButtonElement : visible[0]).click();
      return;
    }
    event.preventDefault();
    const at = visible.indexOf(document.activeElement as HTMLButtonElement);
    const next = event.key === 'ArrowDown'
      ? (at + 1) % visible.length
      : (at < 0 ? visible.length - 1 : at + visible.length - 1) % visible.length;
    visible[next].focus();
  });

  dialog?.addEventListener('click', (event) => {
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
</script>
