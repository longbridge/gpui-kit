---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsLicense from '../components/DocsLicense.astro';
import Toc from '../components/Toc.astro';
import type { Heading } from '../components/Toc.astro';
import type { SidebarItem } from '../lib/sidebar';
import { fetchStarCount } from '../lib/github';
import { SITE_URL } from '../lib/site';
import { currentVersionPath } from '../lib/versions';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
  sidebar?: SidebarItem[];
  headings?: Heading[];
  frontmatter?: Record<string, any>;
}

const { title, description, lang = 'en', sidebar = [], headings = [], frontmatter = {} } = Astro.props;
const hasSidebar = sidebar.length > 0;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const canonical = `${SITE_URL}${pathname}`;
const contentPath = currentVersionPath(pathname, base);
const isDocumentationPage = /^\/(?:zh-CN\/)?(?:docs|base|component|shell)(?:\/|$)/.test(contentPath);

let starCount = 0;
try {
  starCount = await fetchStarCount();
} catch {}

const isZh = lang === 'zh-CN';
const segments = pathname.split('/').filter(Boolean);
const itemListElement = segments
  .filter(segment => segment !== 'zh-CN')
  .map((segment, index, visibleSegments) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: index === visibleSegments.length - 1 && title
      ? title
      : segment.replace(/[-_]/g, ' ').replace(/\b\w/g, char => char.toUpperCase()),
    item: `${SITE_URL}/${isZh ? 'zh-CN/' : ''}${visibleSegments.slice(0, index + 1).join('/')}`,
  }));
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: isZh ? 'zh-CN' : 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  },
];
---

<BaseLayout title={title} description={description} lang={isZh ? 'zh-CN' : 'en'} canonical={canonical} structuredData={structuredData}>
  <Nav lang={lang} currentPath={pathname} starCount={starCount} />

  <div class="docs-layout">
    {hasSidebar && <Sidebar items={sidebar} currentPath={pathname} lang={lang} />}

    <main class:list={['docs-main', { 'docs-main--full': !hasSidebar }]}>
      <article class="doc-content" data-pagefind-body>
        <slot />
      </article>
      {isDocumentationPage && <DocsLicense lang={lang} sourceUrl={canonical} />}
    </main>

    {hasSidebar && <Toc headings={headings} lang={lang} />}
  </div>

  <!-- Page-level, so it spans the shared content box rather than the
       article's reading measure. -->
  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  const copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';
  const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>';
  const isZh = document.documentElement.lang === 'zh-CN';

  for (const pre of document.querySelectorAll<HTMLPreElement>('.doc-content pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'doc-code-copy';
    button.setAttribute('aria-label', isZh ? '复制代码' : 'Copy code');
    button.innerHTML = copyIcon;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.dataset.copied = '';
        button.setAttribute('aria-label', isZh ? '已复制' : 'Copied');
        button.innerHTML = checkIcon;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', isZh ? '复制代码' : 'Copy code');
          button.innerHTML = copyIcon;
        }, 1600);
      } catch {}
    });

    pre.append(button);
  }

  for (const demo of document.querySelectorAll<HTMLElement>('.keybinding-demo')) {
    for (const button of demo.querySelectorAll<HTMLButtonElement>('[data-focus-target]')) {
      button.addEventListener('click', () => {
        demo.dataset.focus = button.dataset.focusTarget;
        for (const target of demo.querySelectorAll<HTMLButtonElement>('[data-focus-target]')) {
          target.setAttribute('aria-pressed', String(target === button));
        }
      });
    }
  }

  for (const timeline of document.querySelectorAll<HTMLElement>('[data-frame-timeline]')) {
    const toggle = timeline.querySelector<HTMLButtonElement>('[data-frame-timeline-toggle]');
    if (!toggle) continue;

    const pauseLabel = isZh ? '暂停动画' : 'Pause animation';
    const playLabel = isZh ? '播放动画' : 'Play animation';
    const setPaused = (paused: boolean) => {
      timeline.dataset.paused = String(paused);
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? playLabel : pauseLabel;
    };

    setPaused(false);
    timeline.dataset.ready = '';
    toggle.addEventListener('click', () => setPaused(timeline.dataset.paused !== 'true'));
  }
</script>

<style is:global>
  @import '../styles/global.css';
</style>
