---
import HomeLayout from '../layouts/HomeLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeApp from '../components/HomeApp.vue';
import { fetchStarCount } from '../lib/github';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
---

<HomeLayout
  lang="en"
  title="GPUI Kit"
  description="GPUI Kit is a production-ready Rust UI framework with 75+ components and primitives, WebAssembly, accessibility, UI integration testing, data tables, docking, charts, and code editing."
>
  <Nav lang="en" currentPath={Astro.url.pathname} starCount={starCount} />

  <HomeApp client:load starCount={starCount} base={base} lang="en" />

  <SiteFooter lang="en" />
</HomeLayout>
