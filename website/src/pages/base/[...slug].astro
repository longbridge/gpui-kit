---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { enBaseSidebar } from '../../lib/sidebar';
import ComponentExample from '../../components/ComponentExample.vue';

export async function getStaticPaths() {
  const entries = await getCollection('base');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const devVersion = import.meta.env.DEV ? 'dev' : undefined;
const seoTitle = entry.id === 'index.md' ? entry.data.title : `${entry.data.title} — GPUI Base`;
---

<DocsLayout
  title={seoTitle}
  description={entry.data.description}
  lang="en"
  headings={headings}
  sidebar={enBaseSidebar}
>
  <Content />
  {entry.data.example !== false && (
    <ComponentExample
      client:load
      frontmatter={{ ...entry.data, exampleKind: 'base' }}
      pathname={pathname}
      baseUrl={base}
      devVersion={devVersion}
    />
  )}
</DocsLayout>
