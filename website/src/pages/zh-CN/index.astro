---
import HomeLayout from '../../layouts/HomeLayout.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeApp from '../../components/HomeApp.vue';
import { fetchStarCount } from '../../lib/github';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
---

<HomeLayout
  lang="zh-CN"
  title="GPUI Kit"
  description="GPUI Kit 是生产就绪的 Rust UI 框架，提供 75+ 组件与原语、WebAssembly、无障碍、UI 集成测试、数据表格、Dock、图表与代码编辑器。"
>
  <Nav lang="zh-CN" currentPath={Astro.url.pathname} starCount={starCount} />

  <HomeApp client:load starCount={starCount} base={base} lang="zh-CN" />

  <SiteFooter lang="zh-CN" />
</HomeLayout>
