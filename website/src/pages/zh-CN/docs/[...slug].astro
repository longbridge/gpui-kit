---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { zhDocsSidebar } from '../../../lib/sidebar';
import ComponentExample from '../../../components/ComponentExample.vue';

export async function getStaticPaths() {
  const entries = await getCollection('zh-docs');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug: slug === 'index' ? undefined : slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pathname = Astro.url.pathname;
const seoTitle = entry.id === 'index.md'
  ? '文档'
  : entry.id === 'components/index.md'
    ? 'Rust UI 组件'
    : entry.id.startsWith('components/')
      ? `${entry.data.title}组件`
      : `${entry.data.title}指南`;
const base = import.meta.env.BASE_URL;
const devVersion = import.meta.env.DEV ? 'dev' : undefined;
---

<DocsLayout
  title={seoTitle}
  description={entry.data.description}
  lang="zh-CN"
  headings={headings}
  sidebar={zhDocsSidebar}
>
  <Content />
  {entry.data.example !== false && (
    <ComponentExample
      client:load
      frontmatter={entry.data}
      pathname={pathname}
      baseUrl={base}
      devVersion={devVersion}
    />
  )}
</DocsLayout>
